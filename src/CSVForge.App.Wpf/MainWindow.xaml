<Window x:Class="CSVForge.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:CSVForge.App.Wpf"
        xmlns:imports="clr-namespace:CSVForge.Domain.Imports;assembly=CSVForge.Domain"
        Title="CSVForge" Height="820" Width="1380" MinHeight="720" MinWidth="1100"
        Background="{StaticResource AppBackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="CompareFileTemplate">
            <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SourcePath}" />
        </DataTemplate>
    </Window.Resources>
    <Grid>
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111827" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#2563EB" Margin="0,0,10,0">
                        <TextBlock Text="C" Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="CSVForge" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="DATA WORKBENCH" Foreground="#8290A6" FontSize="9" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="WorkspaceStatusText" Grid.Column="1" Visibility="Collapsed" />
                <ComboBox x:Name="WorkspacePathTextBox" Grid.Column="2" Width="320" Height="34" Margin="0,0,8,0"
                          IsEditable="True" IsReadOnly="True" TextSearch.TextPath="DisplayName"
                          VerticalContentAlignment="Center" SelectionChanged="WorkspacePathTextBox_SelectionChanged" ToolTip="Aktywny workspace">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="3" Content="Polecenia  Ctrl+K" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0" Click="ShowCommandPalette_Click" />
                <Button Grid.Column="4" Content="Skróty" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0" Click="ShowShortcuts_Click" />
                <Button Grid.Column="5" Content="Logi" Style="{StaticResource ToolbarButton}" Margin="0,0,8,0" Click="OpenLogs_Click" />
                <Button Grid.Column="6" Content="O programie" Style="{StaticResource ToolbarButton}" Click="ShowAbout_Click" />
            </Grid>
        </Border>

        <Grid Margin="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilesPanelColumn" Width="300" MinWidth="240" MaxWidth="600" />
                    <ColumnDefinition x:Name="FilesPanelSplitterColumn" Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="FilesDropArea" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14"
                        AllowDrop="True" DragEnter="FilesDropArea_DragEnter" DragOver="FilesDropArea_DragOver"
                        DragLeave="FilesDropArea_DragLeave" Drop="FilesDropArea_Drop"
                        AutomationProperties.Name="Lista tabel z plików CSV"
                        AutomationProperties.HelpText="Przeciągnij tutaj pliki CSV lub ZIP albo użyj przycisku dodawania pliku.">
                    <Grid>
                      <DockPanel x:Name="FilesPanelContent">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Pliki CSV" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Źródła danych workspace" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Width="30" Height="30" Margin="4,0,0,0" Padding="5"
                                    ToolTip="Obserwowane foldery" AutomationProperties.Name="Konfiguruj obserwowane foldery"
                                    Click="ConfigureWatchedFolders_Click">
                                <Viewbox><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent" StrokeThickness="1.5" Data="M1,4 L6,4 L8,6 L15,6 L15,14 L1,14 Z M10,2 A3,3 0 1 1 9.99,2" /></Viewbox>
                            </Button>
                            <Button x:Name="CollapseFilesPanelButton" Grid.Column="2" Width="30" Height="30" Margin="4,0,0,0" Padding="6"
                                    ToolTip="Zwiń panel" AutomationProperties.Name="Zwiń panel plików"
                                    Click="SetFilesPanelCollapsed_Click">
                                <Viewbox><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,2 L14,2 L14,14 L2,14 Z M6,2 L6,14 M10,5 L7,8 L10,11" /></Viewbox>
                            </Button>
                            <Button Grid.Column="3" Width="34" Height="34" Content="+" FontSize="19" FontWeight="SemiBold" Margin="6,0,0,0"
                                    Style="{StaticResource PrimaryButton}" Padding="0"
                                    ToolTip="Dodaj plik CSV" AutomationProperties.Name="Dodaj plik CSV"
                                    Click="ChooseCsv_Click" />
                        </Grid>

                        <Expander DockPanel.Dock="Bottom" Header="Historia operacji" Margin="0,10,0,0" IsExpanded="False">
                            <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0" Height="150">
                                <ListBox x:Name="OperationsListBox" SelectionChanged="OperationsListBox_SelectionChanged"
                                         PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Eksportuj" Click="ExportTable_Click" />
                                            <Separator />
                                            <MenuItem Header="Usuń wynik" Click="DeleteOperation_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Expander>

                        <ListBox x:Name="ImportsListBox" SelectionChanged="ImportsListBox_SelectionChanged"
                                 HorizontalContentAlignment="Stretch" PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                                 AllowDrop="True" DragEnter="FilesDropArea_DragEnter" DragOver="FilesDropArea_DragOver"
                                 DragLeave="FilesDropArea_DragLeave" Drop="FilesDropArea_Drop">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Zmień nazwę" Click="RenameImport_Click" />
                                    <MenuItem Header="Eksportuj" Click="ExportTable_Click" />
                                    <Separator />
                                    <MenuItem Header="Usuń" Click="DeleteImport_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.Resources>
                                <DataTemplate DataType="{x:Type local:CsvImportCandidate}">
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Symbol}" Foreground="{Binding StateBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <StackPanel Grid.Column="1" ToolTip="{Binding ToolTip}">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{Binding StateBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type imports:CsvImport}">
                                    <TextBlock Text="{Binding DisplayName}" Padding="2,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ListBox.Resources>
                        </ListBox>
                      </DockPanel>

                      <StackPanel x:Name="CollapsedFilesPanelContent" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                          <Button x:Name="OpenFilesPanelButton" Width="32" Height="32" Padding="7"
                                  ToolTip="Rozwiń panel plików" AutomationProperties.Name="Rozwiń panel plików"
                                  Click="SetFilesPanelExpanded_Click">
                              <Viewbox><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,2 L14,2 L14,14 L2,14 Z M6,2 L6,14 M8,5 L11,8 L8,11" /></Viewbox>
                          </Button>
                          <TextBlock Text="Pliki CSV" Margin="0,18,0,0" FontWeight="SemiBold"
                                     Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center">
                              <TextBlock.LayoutTransform>
                                  <RotateTransform Angle="-90" />
                              </TextBlock.LayoutTransform>
                          </TextBlock>
                      </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter x:Name="FilesPanelSplitter" Grid.Column="1" Width="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeWE" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True" ToolTip="Zmień szerokość panelu plików" />

                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousPageButton" Content="←  Poprzednia" MinWidth="104" IsEnabled="False" Click="PreviousPage_Click" />
                            <Button x:Name="NextPageButton" Grid.Column="1" Content="Następna  →" MinWidth="104" Margin="8,0,0,0" IsEnabled="False" Click="NextPage_Click" />
                            <Button x:Name="ExportResultButton" Grid.Column="3" Content="Eksportuj wynik"
                                    Height="30" MinWidth="112" Margin="8,0,16,0" Padding="12,0"
                                    Visibility="Collapsed" Click="ExportTable_Click"
                                    ToolTip="Eksportuj aktualny wynik operacji do pliku CSV" />
                            <TextBlock x:Name="PageStatusText" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" Text="Brak danych" />
                        </Grid>

                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TableTitleText" Text="Podgląd danych" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Border x:Name="ImportWarningBorder" Background="#FFF7E6" BorderBrush="#F5C76B" BorderThickness="1"
                                    CornerRadius="7" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
                                <TextBlock Foreground="#92400E" TextWrapping="Wrap"
                                           Text="Import danych nadal trwa. Wynik porównania, łączenia lub wyszukiwania duplikatów może być niepełny. Operacje pozostają dostępne." />
                            </Border>

                            <TabControl x:Name="WorkspaceModeTabControl" MinHeight="156" Padding="4">
                                <TabItem x:Name="BrowseTab" Header="Przeglądaj">
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Widok tabeli" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="BrowseFileNameText" Margin="12,0,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                       Text="Brak tabel" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Odśwież dane"
                                                MinWidth="112" Click="RefreshTable_Click" />
                                    </Grid>
                                </TabItem>

                                <TabItem x:Name="DuplicatesTab" Header="Duplikaty">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Kolumny kluczowe" VerticalAlignment="Center" />
                                        <ComboBox x:Name="DuplicateColumnComboBox" Grid.Column="1" Grid.ColumnSpan="3" Height="30" Margin="10,0,20,6"
                                                  IsEditable="True" ToolTip="Wybierz jedną kolumnę lub wpisz kilka nazw oddzielonych przecinkami" />
                                        <TextBlock Grid.Row="1" Text="Widok wyniku" VerticalAlignment="Center" />
                                        <ComboBox x:Name="DuplicateModeComboBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="10,0,20,0" SelectedIndex="0">
                                            <ComboBoxItem Content="Wszystkie wiersze" Tag="AllDuplicateRows" />
                                            <ComboBoxItem Content="Podsumowanie" Tag="Summary" />
                                        </ComboBox>
                                        <CheckBox x:Name="IgnoreEmptyKeysCheckBox" Grid.Row="1" Grid.Column="2" Content="Pomiń puste klucze" IsChecked="True" VerticalAlignment="Center" />
                                        <Button Grid.Row="1" Grid.Column="4" Content="Znajdź duplikaty" Style="{StaticResource PrimaryButton}" MinWidth="142" Click="FindDuplicates_Click" />
                                    </Grid>
                                </TabItem>

                                <TabItem x:Name="CompareTab" Header="Porównaj">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" MinWidth="244" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Plik 1" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CompareLeftTableComboBox" Grid.Column="1" Height="30" Margin="10,0,18,6"
                                                  ItemTemplate="{StaticResource CompareFileTemplate}"
                                                  HorizontalContentAlignment="Stretch"
                                                  SelectionChanged="CompareLeftTableComboBox_SelectionChanged" />
                                        <TextBlock Grid.Column="2" Text="Klucze pliku 1" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CompareLeftKeyColumnsComboBox" Grid.Column="3" Height="30" Margin="10,0,0,6"
                                                  IsEditable="True" SelectionChanged="CompareLeftKeyColumnsComboBox_SelectionChanged"
                                                  ToolTip="Wybierz jedną kolumnę lub wpisz kilka nazw oddzielonych przecinkami" />
                                        <TextBlock Grid.Row="1" Text="Plik 2" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CompareTableComboBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="10,0,18,6"
                                                  ItemTemplate="{StaticResource CompareFileTemplate}"
                                                  HorizontalContentAlignment="Stretch"
                                                  SelectionChanged="CompareTableComboBox_SelectionChanged" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Klucze pliku 2" VerticalAlignment="Center" />
                                        <ComboBox x:Name="RightKeyColumnsTextBox" Grid.Row="1" Grid.Column="3" Height="30" Margin="10,0,0,6"
                                                  IsEditable="True" ToolTip="Wybierz jedną kolumnę lub wpisz kilka nazw oddzielonych przecinkami" />
                                        <StackPanel x:Name="AdditionalCompareFilesPanel" Grid.Row="2" Grid.ColumnSpan="4" />
                                        <TextBlock Grid.Row="3" Text="Wynik" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CompareModeComboBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="30" Margin="10,4,18,0" SelectedIndex="0">
                                            <ComboBoxItem Content="Wszystko ze statusem" Tag="AllWithStatus" />
                                            <ComboBoxItem Content="We wszystkich plikach" Tag="CommonRows" />
                                            <ComboBoxItem Content="Nieobecne w części plików" Tag="DifferentRows" />
                                        </ComboBox>
                                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,4,0,0">
                                            <Button Content="+ Dodaj plik" MinWidth="104" Margin="0,0,8,0" Click="AddCompareFile_Click" />
                                            <Button Content="Porównaj pliki" Style="{StaticResource PrimaryButton}" MinWidth="132" Click="CompareTables_Click" />
                                        </StackPanel>
                                    </Grid>
                                </TabItem>

                                <TabItem x:Name="JoinTab" Header="Połącz">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Klucze lewe" VerticalAlignment="Center" />
                                        <ComboBox x:Name="JoinLeftKeyColumnsComboBox" Grid.Column="1" Height="30" Margin="10,0,18,6"
                                                  IsEditable="True" SelectionChanged="JoinLeftKeyColumnsComboBox_SelectionChanged"
                                                  ToolTip="Wybierz jedną kolumnę lub wpisz kilka nazw oddzielonych przecinkami" />
                                        <TextBlock Grid.Column="2" Text="Prawy plik" VerticalAlignment="Center" />
                                        <ComboBox x:Name="JoinTableComboBox" Grid.Column="3" Grid.ColumnSpan="3" Height="30" Margin="10,0,18,6"
                                                  DisplayMemberPath="DisplayName" SelectionChanged="JoinTableComboBox_SelectionChanged" />

                                        <TextBlock Grid.Row="1" Text="Klucze prawe" VerticalAlignment="Center" />
                                        <TextBox x:Name="JoinRightKeyColumnsTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="30" Margin="10,0,18,0" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Typ" VerticalAlignment="Center" />
                                        <ComboBox x:Name="JoinTypeComboBox" Grid.Row="1" Grid.Column="5" Height="30" Margin="10,0,18,0" SelectedIndex="0">
                                            <ComboBoxItem Content="LEFT" Tag="Left" />
                                            <ComboBoxItem Content="INNER" Tag="Inner" />
                                            <ComboBoxItem Content="RIGHT" Tag="Right" />
                                        </ComboBox>
                                        <Button Grid.Row="1" Grid.Column="6" Content="Połącz pliki" Style="{StaticResource PrimaryButton}" MinWidth="132" Click="JoinTables_Click" />

                                        <TextBlock Grid.Row="2" Text="Kolumny lewe" Margin="0,8,0,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="LeftOutputColumnsTextBox" Grid.Row="2" Grid.Column="1" Height="28" Margin="10,8,18,0" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Kolumny prawe" Margin="0,8,0,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="RightOutputColumnsTextBox" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3" Height="28" Margin="10,8,18,0" VerticalContentAlignment="Center" />
                                    </Grid>
                                </TabItem>

                                <TabItem x:Name="SqlTab" Header="SQL">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="120" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Zapytanie do aktywnego workspace" FontWeight="SemiBold" />
                                        <Border Grid.Row="1" Margin="0,7,0,7" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                            <avalonEdit:TextEditor x:Name="SqlQueryTextBox"
                                                                   ShowLineNumbers="True"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="13"
                                                                   Background="#FBFCFE"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   HorizontalScrollBarVisibility="Auto"
                                                                   VerticalScrollBarVisibility="Auto"
                                                                   Text="SELECT name, type FROM sqlite_master ORDER BY type, name;" />
                                        </Border>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SqlStatusText" Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Text="Ctrl+Enter wykonuje zapytanie" />
                                            <Button Grid.Column="1" Content="Wyczyść" Margin="8,0" Click="ClearSql_Click" />
                                            <Button Grid.Column="2" Content="Wykonaj SQL" Style="{StaticResource PrimaryButton}"
                                                    MinWidth="120" Click="ExecuteSql_Click" />
                                        </Grid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </StackPanel>

                        <DataGrid x:Name="DataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionUnit="Cell"
                                  SelectionMode="Extended"
                                  ClipboardCopyMode="ExcludeHeader"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  Sorting="DataGrid_Sorting"
                                  LoadingRow="DataGrid_LoadingRow"
                                  PreviewKeyDown="DataGrid_PreviewKeyDown"
                                  PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  AutomationProperties.HelpText="Zaznacz jedną lub wiele komórek i naciśnij Control+C, aby skopiować ich wartości.">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Kopiuj zaznaczone komórki"
                                              InputGestureText="Ctrl+C"
                                              Click="CopySelectedCell_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
      </DockPanel>

      <Border x:Name="StatusOverlay" Panel.ZIndex="100" Visibility="Collapsed"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20"
              MinWidth="320" MaxWidth="620" Padding="16,10"
              Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
          <Border.Effect>
              <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" />
          </Border.Effect>
          <Grid>
              <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ProgressBar x:Name="OperationProgressBar" Width="90" Height="6" Margin="0,0,12,0"
                           IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
              <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource TextMutedBrush}"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="ImportStatusText" Grid.Column="2" Foreground="#B45309" FontWeight="SemiBold"
                         VerticalAlignment="Center" Margin="16,0" Visibility="Collapsed" />
              <Button x:Name="CancelOperationButton" Grid.Column="3" Content="Anuluj operację" MinHeight="28"
                      Padding="10,0" Visibility="Collapsed" Click="CancelOperation_Click" />
          </Grid>
      </Border>
    </Grid>
</Window>
