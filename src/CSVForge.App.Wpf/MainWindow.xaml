<Window x:Class="CSVForge.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSVForge" Height="720" Width="1120" MinHeight="620" MinWidth="960"
        Background="#F6F7F9">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17202A" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CSVForge" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="WorkspaceStatusText" Grid.Column="1" Foreground="#D6DEE8" Margin="18,0,0,0" VerticalAlignment="Center" Text="Brak otwartego workspace" />
                <ProgressBar x:Name="OperationProgressBar" Grid.Column="2" Width="110" Height="8" Margin="0,0,12,0" IsIndeterminate="True" Visibility="Collapsed" />
                <Button x:Name="CancelOperationButton" Grid.Column="3" Content="Anuluj" Height="28" Margin="0,0,12,0" Padding="10,0" Visibility="Collapsed" Click="CancelOperation_Click" />
                <TextBlock x:Name="StatusText" Grid.Column="4" Foreground="#D6DEE8" VerticalAlignment="Center" Text="Gotowy" />
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Workspace" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox x:Name="WorkspacePathTextBox" Grid.Column="1" Height="32" Margin="8,0" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="Utwórz / otwórz" Height="32" MinWidth="120" Padding="12,0" Click="OpenWorkspace_Click" />

                    <TextBlock Grid.Row="1" Text="CSV" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBox x:Name="CsvPathTextBox" Grid.Row="1" Grid.Column="1" Height="32" Margin="8,10,8,0" VerticalContentAlignment="Center" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Wybierz" Height="32" MinWidth="86" Margin="0,10,8,0" Padding="12,0" Click="ChooseCsv_Click" />
                    <Button Grid.Row="1" Grid.Column="3" Content="Importuj" Height="32" MinWidth="96" Margin="0,10,0,0" Padding="12,0" Click="ImportCsv_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Tabele" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ExportDelimiterComboBox" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="Średnik (;)" Tag=";" />
                                <ComboBoxItem Content="Przecinek (,)" Tag="," />
                                <ComboBoxItem Content="Tabulator" Tag="&#9;" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="Eksportuj" Height="30" Margin="8,0,0,0" Padding="12,0" Click="ExportTable_Click" />
                        </Grid>
                        <ListBox x:Name="ImportsListBox" DisplayMemberPath="DisplayName" SelectionChanged="ImportsListBox_SelectionChanged" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="12" Margin="14,0,0,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousPageButton" Content="Poprzednia" Height="30" MinWidth="90" IsEnabled="False" Click="PreviousPage_Click" />
                            <Button x:Name="NextPageButton" Grid.Column="1" Content="Następna" Height="30" MinWidth="90" Margin="8,0,0,0" IsEnabled="False" Click="NextPage_Click" />
                            <TextBlock x:Name="PageStatusText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Brak danych" />
                        </Grid>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TableTitleText" Text="Dane" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox x:Name="FilterTextBox" Grid.Column="1" Height="30" Margin="8,0" VerticalContentAlignment="Center" />
                            <ComboBox x:Name="DuplicateColumnComboBox" Grid.Column="2" Height="30" Margin="0,0,8,0" />
                            <ComboBox x:Name="CompareTableComboBox" Grid.Column="3" Height="30" Margin="0,0,8,0" DisplayMemberPath="DisplayName" />
                            <Button Grid.Column="4" Content="Duplikaty" Height="30" MinWidth="88" Margin="0,0,8,0" Padding="12,0" Click="FindDuplicates_Click" />
                            <Button Grid.Column="5" Content="Porównaj" Height="30" MinWidth="86" Margin="0,0,8,0" Padding="12,0" Click="CompareTables_Click" />
                            <Button Grid.Column="6" Content="Połącz" Height="30" MinWidth="76" Margin="0,0,8,0" Padding="12,0" Click="JoinTables_Click" />
                            <Button Grid.Column="7" Content="Filtruj" Height="30" MinWidth="78" Padding="12,0" Click="RefreshTable_Click" />
                        </Grid>
                        <DataGrid x:Name="DataGrid"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
