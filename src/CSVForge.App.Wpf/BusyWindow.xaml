<Window x:Class="CSVForge.App.Wpf.BusyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSVForge" Width="390" Height="132"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        AllowsTransparency="True">
    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="MessageText" FontSize="14" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <ProgressBar Height="6" Margin="0,18,0,0" IsIndeterminate="True"
                         AutomationProperties.Name="Operacja w toku" />
        </StackPanel>
    </Border>
</Window>
