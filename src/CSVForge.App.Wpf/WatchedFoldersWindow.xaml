<Window x:Class="CSVForge.App.Wpf.WatchedFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obserwowane foldery" Width="720" Height="430" MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Foldery z plikami CSV i ZIP" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <DataGrid x:Name="FoldersGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Aktywny" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="Folder" Binding="{Binding Path}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Stan" Binding="{Binding Status}" IsReadOnly="True" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Dodaj folder" Padding="12,6" Click="Add_Click"/>
                <Button Content="Usuń" Padding="12,6" Margin="8,0,0,0" Click="Remove_Click"/>
                <Button Content="Skanuj ponownie" Padding="12,6" Margin="8,0,0,0" Click="Rescan_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Anuluj" MinWidth="82" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Zapisz" MinWidth="92" IsDefault="True" Background="#2563EB" Foreground="White" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
