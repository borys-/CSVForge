<Window x:Class="CSVForge.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSVForge" Height="760" Width="1240" MinHeight="680" MinWidth="1040"
        Background="#F6F7F9">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17202A" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CSVForge" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="WorkspaceStatusText" Grid.Column="1" Visibility="Collapsed" />
                <ProgressBar x:Name="OperationProgressBar" Grid.Column="2" Width="110" Height="8" Margin="0,0,12,0" IsIndeterminate="True" Visibility="Collapsed" />
                <Button x:Name="CancelOperationButton" Grid.Column="3" Content="Anuluj" Height="28" Margin="0,0,12,0" Padding="10,0" Visibility="Collapsed" Click="CancelOperation_Click" />
                <ComboBox x:Name="WorkspacePathTextBox" Grid.Column="4" Width="300" Height="28" Margin="0,0,8,0"
                          VerticalContentAlignment="Center" SelectionChanged="WorkspacePathTextBox_SelectionChanged" ToolTip="Aktywny workspace" />
                <Button Grid.Column="5" Content="Logi" Height="28" Margin="0,0,8,0" Padding="10,0" Click="OpenLogs_Click" />
                <Button Grid.Column="6" Content="Pomoc" Height="28" Margin="0,0,12,0" Padding="10,0" Click="ShowHelp_Click" />
                <TextBlock x:Name="StatusText" Grid.Column="7" Foreground="#D6DEE8" VerticalAlignment="Center" Text="Gotowy" />
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FilesPanelColumn" Width="300" MinWidth="220" MaxWidth="600" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pliki CSV" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="30" Height="30" Content="+" FontSize="20" FontWeight="SemiBold"
                                    Background="#218739" Foreground="White" BorderBrush="#176B2C"
                                    ToolTip="Dodaj plik CSV" Click="ChooseCsv_Click" />
                        </Grid>

                        <Expander DockPanel.Dock="Bottom" Header="Historia operacji" Margin="0,10,0,0" IsExpanded="False">
                            <Border BorderBrush="#D8DEE8" BorderThickness="1" Margin="0,6,0,0" Height="150">
                                <ListBox x:Name="OperationsListBox" SelectionChanged="OperationsListBox_SelectionChanged"
                                         PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Eksportuj" Click="ExportTable_Click" />
                                            <Separator />
                                            <MenuItem Header="Usuń wynik" Click="DeleteOperation_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Expander>

                        <ListBox x:Name="ImportsListBox" SelectionChanged="ImportsListBox_SelectionChanged"
                                 HorizontalContentAlignment="Stretch" PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Zmień nazwę" Click="RenameImport_Click" />
                                    <MenuItem Header="Eksportuj" Click="ExportTable_Click" />
                                    <Separator />
                                    <MenuItem Header="Usuń" Click="DeleteImport_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Padding="2,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" Cursor="SizeWE" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True" ToolTip="Zmień szerokość panelu plików" />

                <Border Grid.Column="2" Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviousPageButton" Content="Poprzednia" Height="30" MinWidth="90" IsEnabled="False" Click="PreviousPage_Click" />
                            <Button x:Name="NextPageButton" Grid.Column="1" Content="Następna" Height="30" MinWidth="90" Margin="8,0,0,0" IsEnabled="False" Click="NextPage_Click" />
                            <TextBlock x:Name="PageStatusText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Brak danych" />
                        </Grid>

                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TableTitleText" Text="Dane" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="Filtr wierszy" Margin="16,0,8,0" VerticalAlignment="Center" />
                                <TextBox x:Name="FilterTextBox" Grid.Column="2" Height="30" VerticalContentAlignment="Center" KeyDown="FilterTextBox_KeyDown" />
                                <Button Grid.Column="3" Content="Wyczyść" Height="30" MinWidth="76" Margin="8,0,0,0" Padding="12,0" Click="ClearFilter_Click" />
                                <Button Grid.Column="4" Content="Filtruj" Height="30" MinWidth="78" Margin="8,0,0,0" Padding="12,0" Click="RefreshTable_Click" />
                            </Grid>

                            <Grid Margin="0,10,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="360" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Klucze lewego pliku" VerticalAlignment="Center" />
                                <ComboBox x:Name="DuplicateColumnComboBox" Grid.Column="1" Height="30" Margin="10,0,0,0" IsEditable="True" ToolTip="Wybierz jedną kolumnę lub wpisz kilka nazw oddzielonych przecinkami" />
                            </Grid>

                            <TabControl MinHeight="108" Padding="4">
                                <TabItem Header="Duplikaty">
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Widok wyniku" VerticalAlignment="Center" />
                                        <ComboBox x:Name="DuplicateModeComboBox" Grid.Column="1" Height="30" Margin="10,0,20,0" SelectedIndex="0">
                                            <ComboBoxItem Content="Wszystkie wiersze" Tag="AllDuplicateRows" />
                                            <ComboBoxItem Content="Podsumowanie" Tag="Summary" />
                                        </ComboBox>
                                        <CheckBox x:Name="IgnoreEmptyKeysCheckBox" Grid.Column="2" Content="Pomiń puste klucze" IsChecked="True" VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Content="Znajdź duplikaty" Height="32" MinWidth="132" Padding="14,0" Click="FindDuplicates_Click" />
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Porównaj">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Lewy plik" VerticalAlignment="Center" />
                                        <TextBox x:Name="CompareLeftFileTextBox" Grid.Column="1" Grid.ColumnSpan="2" Height="30" Margin="10,0,18,6"
                                                 IsReadOnly="True" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Prawy plik" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CompareTableComboBox" Grid.Column="4" Grid.ColumnSpan="3" Height="30" Margin="10,0,0,6"
                                                  DisplayMemberPath="SourcePath" SelectionChanged="CompareTableComboBox_SelectionChanged" />
                                        <TextBlock Grid.Row="1" Text="Klucze prawe" VerticalAlignment="Center" />
                                        <TextBox x:Name="RightKeyColumnsTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="30" Margin="10,0,18,0" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="Wynik" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CompareModeComboBox" Grid.Row="1" Grid.Column="5" Height="30" Margin="10,0,18,0" SelectedIndex="0">
                                            <ComboBoxItem Content="Wszystko ze statusem" Tag="AllWithStatus" />
                                            <ComboBoxItem Content="Wspólne" Tag="CommonRows" />
                                            <ComboBoxItem Content="Tylko lewa" Tag="LeftOnly" />
                                            <ComboBoxItem Content="Tylko prawa" Tag="RightOnly" />
                                        </ComboBox>
                                        <Button Grid.Row="1" Grid.Column="6" Content="Porównaj pliki" Height="32" MinWidth="126" Padding="14,0" Click="CompareTables_Click" />
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Połącz">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Prawy plik" VerticalAlignment="Center" />
                                        <ComboBox x:Name="JoinTableComboBox" Grid.Column="1" Height="30" Margin="10,0,18,0" DisplayMemberPath="DisplayName" SelectionChanged="JoinTableComboBox_SelectionChanged" />
                                        <TextBlock Grid.Column="2" Text="Klucze prawe" VerticalAlignment="Center" />
                                        <TextBox x:Name="JoinRightKeyColumnsTextBox" Grid.Column="3" Height="30" Margin="10,0,18,0" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="Typ" VerticalAlignment="Center" />
                                        <ComboBox x:Name="JoinTypeComboBox" Grid.Column="5" Height="30" Margin="10,0,18,0" SelectedIndex="0">
                                            <ComboBoxItem Content="LEFT" Tag="Left" />
                                            <ComboBoxItem Content="INNER" Tag="Inner" />
                                            <ComboBoxItem Content="RIGHT" Tag="Right" />
                                        </ComboBox>
                                        <Button Grid.Column="6" Content="Połącz pliki" Height="32" MinWidth="126" Padding="14,0" Click="JoinTables_Click" />

                                        <TextBlock Grid.Row="1" Text="Kolumny lewe" Margin="0,8,0,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="LeftOutputColumnsTextBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="10,8,18,0" VerticalContentAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Kolumny prawe" Margin="0,8,0,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="RightOutputColumnsTextBox" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Height="28" Margin="10,8,18,0" VerticalContentAlignment="Center" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </StackPanel>

                        <DataGrid x:Name="DataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  Sorting="DataGrid_Sorting"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
