<Window x:Class="CSVForge.App.Wpf.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import CSV" Width="980" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F6F7F9">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Przygotuj import" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="FileNameText" Margin="0,4,0,0" Foreground="#52606D" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,12" Padding="12" Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Nazwa w workspace" VerticalAlignment="Center" />
                <TextBox x:Name="DisplayNameTextBox" Grid.Column="1" Height="30" Margin="10,0,24,0" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Nagłówek" VerticalAlignment="Center" />
                <ComboBox x:Name="HeaderModeComboBox" Grid.Column="3" Height="30" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="PreviewSetting_Changed">
                    <ComboBoxItem Content="Wykryj automatycznie" Tag="Auto" />
                    <ComboBoxItem Content="Pierwszy wiersz" Tag="Yes" />
                    <ComboBoxItem Content="Brak nagłówka" Tag="No" />
                </ComboBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Podgląd pierwszych 100 wierszy" FontWeight="SemiBold" />
                        <TextBlock x:Name="PreviewStatusText" Grid.Column="1" Foreground="#52606D" />
                    </Grid>
                    <DataGrid x:Name="PreviewDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" EnableRowVirtualization="True" EnableColumnVirtualization="True" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="12,0,0,0" Background="White" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Kolumny do importu" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Bottom" Text="Odznacz kolumnę, aby ją pominąć. Nazwy i typy można edytować." Foreground="#52606D" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <DataGrid x:Name="ColumnSettingsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Import" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                            <DataGridTextColumn Header="Źródło" Binding="{Binding SourceName}" IsReadOnly="True" Width="*" MinWidth="90" />
                            <DataGridTextColumn Header="Nazwa" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="90" />
                            <DataGridComboBoxColumn x:Name="ColumnTypeDataGridColumn" Header="Typ" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValueBinding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" Width="135" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar x:Name="ImportProgressBar" Width="140" Height="8" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="OperationStatusText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#52606D" />
            </StackPanel>
            <Button Grid.Column="1" Content="Anuluj" Width="96" Height="34" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="ImportButton" Grid.Column="2" Content="Importuj" Width="110" Height="34" IsDefault="True" Click="Import_Click" />
        </Grid>
    </Grid>
</Window>
